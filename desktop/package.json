{
  "name": "hearth",
  "productName": "Hearth",
  "version": "0.2.0",
  "description": "Hearth desktop app for Linux",
  "license": "CC-BY-NC-SA-4.0",
  "author": "newtox",
  "homepage": "https://github.com/newtox/hearth",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "web": "npm --prefix ../web run build && rm -rf web && cp -r ../web/dist web",
    "start": "electron .",
    "build": "electron-builder --linux"
  },
  "dependencies": {
    "@vencord/venmic": "7.2.5",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "de.newtox.hearth",
    "productName": "Hearth",
    "executableName": "hearth",
    "artifactName": "Hearth_${version}_linux_${arch}.${ext}",
    "files": [
      "main.cjs",
      "preload.cjs",
      "picker.html",
      "web/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@vencord/venmic/**"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network;InstantMessaging;Chat",
      "icon": "build/icons",
      "synopsis": "Private chat with voice and screen sharing",
      "desktop": {
        "entry": {
          "StartupWMClass": "Hearth",
          "Name": "Hearth"
        }
      },
      "maintainer": "newtox <justin.lys26@gmail.com>",
      "vendor": "newtox"
    },
    "deb": {
      "depends": [
        "libnotify4",
        "libxss1",
        "libnss3",
        "libasound2 | libasound2t64",
        "libpipewire-0.3-0 | libpipewire-0.3-0t64"
      ]
    },
    "rpm": {
      "depends": [
        "libnotify",
        "nss",
        "alsa-lib",
        "pipewire-libs"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "newtox",
        "repo": "hearth"
      }
    ]
  }
}
